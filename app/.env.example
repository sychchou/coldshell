# Solana network the site talks to: localnet (default), devnet or mainnet
VITE_SOLANA_NETWORK=devnet
# RPC endpoint. On devnet use your Helius URL:
# https://devnet.helius-rpc.com/?api-key=YOUR_KEY
VITE_RPC_URL=https://api.devnet.solana.com

# There is no day-length setting any more. A day is whatever the deployed program says it is —
# build it with the `short-clock` feature and the screen follows, because every duration on the
# screen is read out of the IDL.
