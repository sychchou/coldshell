# Where the site is served from, for CORS.
APP_URL=http://localhost:5173
PORT=8787

# The cluster the program is deployed to.
RPC_URL=http://127.0.0.1:8899
# On devnet, a Helius URL if you have one:
# RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# The wallet that pays every fee and all lamport of rent, so that taking part never requires
# holding SOL. It is a hot key by necessity: keep it away from the program's upgrade authority,
# and keep only enough SOL in it to run for a while.
PAYER_KEY_PATH=.keys/payer.json
# Hosted deployments pass the key itself instead, as a JSON array:
# PAYER_SECRET_KEY=[12,34,...]

# Where clips and their notes live. Mount a volume here in deployment.
CLIP_DIR=data/clips
# Ten minutes at 1.2 Mbps is about 90 MB; leave room above that and refuse the rest.
# MAX_CLIP_BYTES=134217728
# MIN_CLIP_BYTES=100000
